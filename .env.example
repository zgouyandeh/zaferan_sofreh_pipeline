# Copy to .env and fill in real values. Never commit .env — add it to .gitignore.

# --- Aiven Kafka (streaming/aiven_kafka_producer.py) --------------------------
# Free-tier alternative to Event Hub when you don't have an Azure subscription.
AIVEN_BOOTSTRAP_SERVERS=kafka-xxxxxxxx.aivencloud.com:PORT
AIVEN_USERNAME=xxxxx
AIVEN_PASSWORD=xxxxx
AIVEN_TOPIC=restaurant-orders
# Optional: path to the ca.pem Aiven gives you in its console, for proper


AIVEN_PG_HOST=XXXXX
AIVEN_PG_PORT=xxxxx
AIVEN_PG_DB=xxxxx
AIVEN_PG_USER=xxxxx
AIVEN_PG_PASSWORD=xxxxxxx


# Use Databricks CLI to store secrets in a secure scope instead of hardcoding them in .env.
# databricks secrets create-scope aiven 
# databricks secrets put-secret aiven kafka-username --string-value "your_username" --profile databricks
# databricks secrets put-secret aiven  kafka-password --string-value "your_password" --profile databricks


# databricks secrets put-secret aiven-postgres host --string-value "your_host" --profile databricks
# databricks secrets put-secret aiven-postgres port --string-value "your_port" --profile databricks
# databricks secrets put-secret aiven-postgres db --string-value "your_db" --profile databricks
# databricks secrets put-secret aiven-postgres user --string-value "your_user" --profile databricks
# databricks secrets put-secret aiven-postgres password --string-value "your_password" --profile databricks

