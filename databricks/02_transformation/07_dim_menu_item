from pyspark import pipelines as dp
from pyspark.sql.functions import col


@dp.table(  name="dim_menu_item",    table_properties={"quality":"silver"})

@dp.expect_or_drop("restaurant_id_not_null", "restaurant_id IS NOT NULL")
@dp.expect_or_drop("item_id_not_null", "item_id IS NOT NULL")
def dim_menu_item():
    return spark.readStream.table("zaferan_sofreh.bronze.menu_items_raw").select(
        "restaurant_id",
        "item_id",
        "name",
        "category",
        col("price").cast("decimal(10,2)").alias("price"),
        "ingredients",
        "is_vegetarian",
        "spice_level",
    )